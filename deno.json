{
  "name": "@youseiushida/gtrends",
  "version": "0.1.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/testing": "jsr:@std/testing@^1"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check mod.ts",
    "test": "deno test --allow-read src/ tests/",
    "test:live": "deno test --allow-net=trends.google.com --allow-read --allow-env=GTRENDS_LIVE live/",
    "fixtures": "deno run --allow-net=trends.google.com --allow-write=tests/fixtures --allow-read tools/record_fixtures.ts",
    "cov": "deno test --allow-read --coverage=cov_profile src/ tests/ && deno coverage cov_profile",
    "dry": "deno publish --dry-run"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "test": {
    "include": ["src/", "tests/"]
  },
  "lint": {
    "include": ["src/", "tests/", "live/", "tools/", "mod.ts"],
    "rules": {
      "tags": ["recommended", "jsr"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "include": ["src/", "tests/", "live/", "tools/", "mod.ts"]
  },
  "publish": {
    "include": ["LICENSE", "README.md", "deno.json", "mod.ts", "src/**/*.ts"],
    "exclude": ["**/*_test.ts"]
  },
  "exclude": [".har/", "cov_profile/", "live_integration/"]
}
